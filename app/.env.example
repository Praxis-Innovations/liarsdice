# Supabase Dashboard -> Settings -> API. See docs/SETUP_SUPABASE.md.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Base URL of the server/ API (no trailing slash). Local dev default matches server/.env's PORT.
EXPO_PUBLIC_API_URL=http://localhost:3001

# Google Cloud Console OAuth client IDs. See docs/SETUP_GOOGLE_OAUTH.md.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# Reversed form of the iOS client ID (e.g. com.googleusercontent.apps.XXXX), used by
# app.config.js to configure the native Google Sign-In plugin's URL scheme.
EXPO_PUBLIC_GOOGLE_IOS_URL_SCHEME=

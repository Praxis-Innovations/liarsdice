# Repo-root env file, read only by the Supabase CLI (via `env(...)` substitution in
# supabase/config.toml) when running `supabase start` locally. NOT read by app/ or server/ —
# those have their own .env.example files. See docs/SETUP_SUPABASE.md.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
SUPABASE_AUTH_EXTERNAL_APPLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_APPLE_SECRET=

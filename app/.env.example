# Nakama game server connection. Defaults below work with `docker compose up` locally.
EXPO_PUBLIC_NAKAMA_HOST=localhost
EXPO_PUBLIC_NAKAMA_PORT=7350
EXPO_PUBLIC_NAKAMA_SERVER_KEY=defaultkey
# Set to "true" in production (when Nakama is behind HTTPS/WSS).
EXPO_PUBLIC_NAKAMA_USE_SSL=false

# Google Cloud Console OAuth client IDs. See docs/SETUP_GOOGLE_OAUTH.md.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# Reversed form of the iOS client ID (e.g. com.googleusercontent.apps.XXXX).
EXPO_PUBLIC_GOOGLE_IOS_URL_SCHEME=
